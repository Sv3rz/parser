# Telegram-бот: токен от @BotFather (обязателен для уведомлений)
TELEGRAM_BOT_TOKEN=

# Необязательно: id чата. Если пусто — бот запомнит чат после команды /start
TELEGRAM_CHAT_ID=

# Сервер
PORT=3000
# Интервал опроса alot.pro (1 минута) и случайный разброс ±20% => от 48 до 72 секунд
POLL_MS=60000
POLL_JITTER=0.2
BACKFILL=3000

# Необязательно: паузы между API-запросами (мс), по умолчанию 900–2600
# ALOT_DELAY_MIN_MS=900
# ALOT_DELAY_MAX_MS=2600
